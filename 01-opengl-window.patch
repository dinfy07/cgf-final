diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..7dbe0345f1960990f3f405e9b04c5ee8b81c039c
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,16 @@
+cmake_minimum_required(VERSION 3.20)
+project(SolarSystemExplorer VERSION 1.0 LANGUAGES CXX)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+find_package(OpenGL REQUIRED)
+find_package(glfw3 3.3 REQUIRED)
+find_package(glm REQUIRED)
+add_library(platform INTERFACE)
+target_include_directories(platform INTERFACE include)
+target_compile_definitions(platform INTERFACE GLFW_INCLUDE_NONE GL_SILENCE_DEPRECATION)
+target_link_libraries(platform INTERFACE glfw OpenGL::GL glm::glm)
+add_executable(solar_explorer src/main.cpp)
+target_include_directories(solar_explorer PRIVATE third_party)
+target_link_libraries(solar_explorer PRIVATE platform)
+target_compile_options(solar_explorer PRIVATE -Wall -Wextra -Wpedantic)
+target_compile_definitions(solar_explorer PRIVATE SOLAR_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
diff --git a/src/main.cpp b/src/main.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..215fef27128dc5ddca82287fa38e55d4e5ac51f9
--- /dev/null
+++ b/src/main.cpp
@@ -0,0 +1,66 @@
+#define GLAD_GL_IMPLEMENTATION
+#include <glad/gl.h>
+#undef GLAD_GL_IMPLEMENTATION
+#include <glad/gl.h>
+#include <GLFW/glfw3.h>
+#include <algorithm>
+#include <iostream>
+#include <stdexcept>
+int main() {
+  int width = 1280, height = 720;
+  try {
+    glfwSetErrorCallback([](int e, const char *m) {
+      std::cerr << "GLFW " << e << ": " << m << '\n';
+    });
+    if (!glfwInit())
+      throw std::runtime_error("GLFW initialization failed");
+#ifdef __APPLE__
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 4);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 1);
+    glfwWindowHint(GLFW_OPENGL_FORWARD_COMPAT, GL_TRUE);
+#else
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
+    glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
+#endif
+    glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
+    glfwWindowHint(GLFW_VISIBLE, GLFW_TRUE);
+    glfwWindowHint(GLFW_SCALE_TO_MONITOR, GLFW_FALSE);
+    // One framebuffer pixel per window point makes 1280x720 benchmarks
+    // unambiguous on Retina.
+    glfwWindowHint(GLFW_COCOA_RETINA_FRAMEBUFFER, GLFW_FALSE);
+    auto *window = glfwCreateWindow(width, height, "Solar System Explorer",
+                                    nullptr, nullptr);
+    if (!window)
+      throw std::runtime_error("Cannot create OpenGL window");
+    glfwMakeContextCurrent(window);
+    glfwSwapInterval(1);
+    if (!gladLoadGL((GLADloadfunc)glfwGetProcAddress))
+      throw std::runtime_error("Cannot load OpenGL");
+    std::cout << "OpenGL: " << glGetString(GL_VERSION)
+              << "\nRenderer: " << glGetString(GL_RENDERER) << '\n';
+    {
+      while (!glfwWindowShouldClose(window)) {
+        glfwPollEvents();
+        if (glfwGetKey(window, GLFW_KEY_ESCAPE) == GLFW_PRESS)
+          glfwSetWindowShouldClose(window, true);
+        int fw, fh;
+        glfwGetFramebufferSize(window, &fw, &fh);
+        if (fw == 0 || fh == 0) {
+          glfwWaitEventsTimeout(.1);
+          continue;
+        }
+        glViewport(0, 0, fw, fh);
+        glClearColor(.006f, .009f, .018f, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glfwSwapBuffers(window);
+      }
+    }
+    glfwDestroyWindow(window);
+    glfwTerminate();
+    return 0;
+  } catch (const std::exception &e) {
+    std::cerr << "Error: " << e.what() << '\n';
+    glfwTerminate();
+    return 1;
+  }
+}
